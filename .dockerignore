# Keep the build context (and the image) lean and free of host/runtime state.
# The app recreates what it needs at runtime; demo mode seeds fresh data.

# Version control / IDE
.git
.gitignore
.github
.vscode
.idea

# Python caches / local envs
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/

# Runtime data — must NOT be baked into the image (this is what caused the
# container to serve stale/polluted patient chains). Chain stores and the SQL/
# LMDB data live in mounted volumes or are regenerated on demand.
backend/projects/
lmdb_data/
*.db
*.sqlite3
*.mdb
*.lock

# Node (only used for local tooling, never at runtime)
node_modules/

# Docs, tests and dev assets are not needed to run the service
docs/
tests/
# The operator tools in scripts/ (backup, restore, privileged accounts) run
# inside the container; only the screenshot and smoke-test helpers stay out.
scripts/capture_screenshots.py
scripts/capture_walkthrough.py
scripts/e2e_smoke.py
scripts/check_https_stack.py
*.md
!README.md

# OS cruft
.DS_Store
Thumbs.db

# Deployment settings and secrets never go into the app image: .env holds the
# keys, deploy/ holds the proxy config and the center's TLS key.
.env
.env.*
deploy/
docker-compose*.yml
