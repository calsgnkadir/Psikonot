# PsikoNot — HTTPS front for the app (used by docker-compose.prod.yml).
#
# Do not edit this file to configure a center. What differs between centers
# comes from the environment (the .env file next to the compose files):
#
#   PSIKONOT_DOMAIN     the name the center's computers type, e.g. psikonot.merkez.lan
#   PSIKONOT_TLS_MODE   acme | internal | files   (see docs/HTTPS_DEPLOYMENT.md)
#   PSIKONOT_ACME_EMAIL contact address for Let's Encrypt (acme mode only)
#
# Caddy terminates TLS, redirects http:// to https:// and forwards to the app
# over the internal Docker network. The app sets its own security headers (CSP,
# HSTS, X-Frame-Options, ...); Caddy passes them through untouched.
{
	# Certificates and Caddy's own CA live in the caddy_data volume. Caddy cannot
	# add its root to the center's computers from inside a container, so it does
	# not try; docs/HTTPS_DEPLOYMENT.md says how to install it by hand.
	skip_install_trust

	# A browser that reaches the server by IP address sends no server name.
	default_sni {$PSIKONOT_DOMAIN}

	servers {
		# HTTP/3 would need UDP 443 published as well; TCP is enough here.
		protocols h1 h2
		timeouts {
			read_header 10s
			read_body 60s
			write 180s
			idle 2m
		}
	}
}

# (a) A public domain: certificates from Let's Encrypt (or ZeroSSL), renewed
#     automatically. Needs ports 80 and 443 reachable from the internet.
(tls_acme) {
	tls {$PSIKONOT_ACME_EMAIL}
}

# (b) Caddy's own certificate authority, for a server on a private network.
#     Install its root certificate on the center's computers once.
(tls_internal) {
	tls internal
}

# (c) The center's own certificate (full chain) and key, mounted read-only.
(tls_files) {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
}

{$PSIKONOT_DOMAIN} {
	import tls_{$PSIKONOT_TLS_MODE}

	# The largest request the app takes is a record with an attachment: 2 MB of
	# file, base64-encoded (about 2.7 MB) inside JSON. Anything far larger is
	# refused here, before it reaches the app.
	request_body {
		max_size 10MB
	}

	header {
		# The app sends HSTS (and its CSP and other headers) on every response;
		# "?" only fills HSTS in if a response ever lacks it, so it is never
		# duplicated.
		?Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Do not advertise the server software.
		-Server
		-Via
	}

	# Answers Caddy writes itself: 502 while the app restarts, 413 for an
	# oversized request. They get HSTS too, and no page from the app.
	handle_errors {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			-Server
		}
		respond "{err.status_code} {err.status_text}"
	}

	# Caddy replaces any X-Forwarded-For the client sent with the address it saw
	# and sets X-Forwarded-Proto: https. The app trusts these headers only from
	# Caddy's fixed address (TRUSTED_PROXIES in docker-compose.prod.yml).
	reverse_proxy psikonot:8000 {
		transport http {
			dial_timeout 5s
			response_header_timeout 120s
		}
	}
}
